{
    "title": "Un Fragging en Texas",
    "paragraphs": [
        [0, "'¡Fuera, maldita mancha! ¡Fuera, digo!' - Macbeth (ACTO V, ESCENA PRIMERA)"],
        [13, "Ella habló con Roman."],
        [14, "\"Haré guardia.\""],
        [15, "Había un gruñido de aprobación,"],
        [18, "Ella usó gafas,"],
        [26, "Lágrimas no limpiando nada,"],
        [36, "No se veía inmediatamente"],
        [39, "Su ritmo cardíaco había cambiado."],
        [47, "Ella fijamente a el perro."],
        [48, "Ellos entendian uno al otro."],
        [49, "Ella podía leerlo en sus ojos."],
        [54, "Epílogo"],
        [56, "Es día del luz."],
        [58, "Ella mira la calle enfrente"],
        [59, "y la calle de ayer."],
        [60, "Aproximó pueblo solimente era unas millas adelante."],
        [61, "Detrás Annie,"],
        [62, "El perro llevaron dos caballos {{out of the bush}}"],
        [63, "Roman's, y su propio."],
        [64, "Ellos continuarían para sus viaje"],
        [65, "{{clopping sound of hooves against dirt fading into a blur.}}"],
        [66, "El banditos salieron el bosque"],
        [67, "Con uno menos en su compania."]
    ]
}